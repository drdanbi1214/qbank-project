# Supabase 프로젝트 설정. 배포 서비스의 환경변수에도 같은 값을 넣는다.
# publishable 키는 공개되어도 되는 값이다. 실제 접근 통제는 RLS 가 한다.
VITE_SUPABASE_URL=https://<프로젝트>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_... key>

# R2 전환 전에는 supabase를 유지한다. 전체 복사·검증 후 r2로 바꾼다.
VITE_STORAGE_PROVIDER=supabase
# VITE_R2_GATEWAY_URL=https://qbank-storage-gateway.<account>.workers.dev
# VITE_STORAGE_READ_FALLBACK=true
# VITE_STORAGE_UPLOAD_FALLBACK=false
